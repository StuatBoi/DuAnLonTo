<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox fx:id="searchView" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.net.demo.SearchController"
      stylesheets="@searchView.css"
      styleClass="search-page-container" 
      alignment="TOP_CENTER" 
      fillWidth="true">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER_LEFT" styleClass="search-header">
        <VBox spacing="4">
            <Label text="KẾT QUẢ TÌM KIẾM" styleClass="search-title"/>
            <Label fx:id="lblSearchStatus" text="Vui lòng nhập từ khóa để tìm kiếm phim" styleClass="search-status-text"/>
        </VBox>
    </HBox>

    <FlowPane fx:id="movieGridContainer" 
              VBox.vgrow="ALWAYS"
              styleClass="movie-grid" 
              hgap="20" 
              vgap="25" 
              alignment="TOP_LEFT" 
              minHeight="350"/> <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER" spacing="20" styleClass="pagination-bar">
        <padding>
            <Insets top="20"/>
        </padding>
        <HBox spacing="8" alignment="CENTER">
            <Button fx:id="btnFirstPage" text="&lt;&lt;" styleClass="btn-page-nav" onAction="#handleFirstPage"/>
            <Button fx:id="btnPrevPage" text="&lt;" styleClass="btn-page-nav" onAction="#handlePrevPage"/>
            <Label fx:id="lblPageIndicator" text="Trang 1 / 1" styleClass="page-indicator-text"/>
            <Button fx:id="btnNextPage" text="&gt;" styleClass="btn-page-nav" onAction="#handleNextPage"/>
            <Button fx:id="btnLastPage" text="&gt;&gt;" styleClass="btn-page-nav" onAction="#handleLastPage"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER" styleClass="jump-page-container">
            <Label text="Đến trang:" styleClass="search-status-text"/>
            <TextField fx:id="txtJumpPage" prefWidth="50" styleClass="input-jump-page" promptText="1"/>
            <Button text="ĐI" styleClass="btn-jump-go" onAction="#handleJumpPage"/>
        </HBox>
    </HBox>
</VBox>