<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox id="accountView" fx:id="accountView" spacing="30" styleClass="section" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.net.demo.AccountController">
    <padding>
        <Insets bottom="40" left="60" right="60" top="40" />
    </padding>

    <VBox spacing="5">
        <Label styleClass="account-title" text="THÔNG TIN TÀI KHOẢN" />
        <Label styleClass="hero-subtitle" text="Quản lý thông tin cá nhân và lịch sử đặt vé của bạn tại Cineverse." />
    </VBox>

    <HBox alignment="TOP_LEFT" spacing="40">
        <VBox alignment="TOP_CENTER" prefWidth="320" spacing="20" styleClass="profile-card">
            <StackPane maxWidth="120" prefHeight="120" prefWidth="120" styleClass="avatar-container">
                <Label styleClass="avatar-icon" text="👤" />
            </StackPane>

            <VBox alignment="CENTER_LEFT" fillWidth="true" spacing="15">
                <VBox spacing="2">
                    <Label styleClass="movie-meta" text="Họ và tên" />
                    <Label fx:id="lblUsername" styleClass="profile-name" text="Nguyễn Văn A" />
                </VBox>
                <VBox spacing="2">
                    <Label styleClass="movie-meta" text="Email" />
                    <Label fx:id="lblEmail" styleClass="hero-subtitle" text="nguyenvana@gmail.com" />
                </VBox>
                <VBox spacing="2" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox fillWidth="true" spacing="10">
                <Button fx:id="btnTicketView" maxWidth="1.7976931348623157E308" styleClass="btn-primary" text="Xem vé" />
                <Button fx:id="btnLogout" maxWidth="1.7976931348623157E308" styleClass="btn-danger" text="Đăng Xuất" />
            </VBox>
        </VBox>

        <VBox spacing="15" HBox.hgrow="ALWAYS">
    <Label styleClass="section-title" text="🎟️ LỊCH SỬ ĐẶT VÉ GẦN ĐÂY" />

    <TableView fx:id="ticketHistoryTable" prefHeight="350" styleClass="history-table">
        <columns>
            <TableColumn fx:id="colMovie" prefWidth="164.800048828125" text="Tên Phim" />
            <TableColumn fx:id="colDate" prefWidth="227.9998779296875" text="Ngày Chiếu" />
            <TableColumn fx:id="colSeat" prefWidth="76.800048828125" text="Ghế" />
            <TableColumn fx:id="colPrice" prefWidth="120" text="Tổng Tiền" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnPrevPage" styleClass="btn-outline" text="◀ Trước" />
        
        <Label fx:id="lblPageInfo" styleClass="page-indicator-text" text="Trang 1 / 1" />
        
        <Button fx:id="btnNextPage" styleClass="btn-outline" text="Sau ▶" />
    </HBox>
</VBox>
    </HBox>
</VBox>
