<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      id="coinPurchase"
      fx:id="coinPurchase"
      fx:controller="org.net.demo.CoinPurchaseController"
      alignment="TOP_LEFT" 
      spacing="30.0" 
      style="-fx-background-color: #0c0c0c;" 
      maxHeight="Infinity" maxWidth="Infinity"
      prefWidth="1200.0" prefHeight="800.0">
    
    <padding>
        <Insets top="40.0" right="60.0" bottom="40.0" left="60.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnBack" onAction="#handleBack" text="← Quay lại" 
                style="-fx-background-color: transparent; -fx-text-fill: #e5e5e5; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 0;" />
    </HBox>

    <VBox spacing="10.0">
        <Label text="NẠP XU VÀO TÀI KHOẢN" 
               style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" />
        <Label text="Chọn gói nạp phù hợp để tiếp tục trải nghiệm dịch vụ cao cấp." 
               style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" />
    </VBox>

    <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
        </columnConstraints>
        
        <Button fx:id="btnPack100" onAction="#handleSelectPack" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0"
                style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30 20 30 20;">
                    <Label text="GÓI CƠ BẢN" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Label text="100 Xu" style="-fx-text-fill: #e50914; -fx-font-size: 26px; -fx-font-weight: bold;" />
                    <Label text="20.000 đ" style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" />
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="btnPack300" onAction="#handleSelectPack" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1"
                style="-fx-background-color: #1a1a1a; -fx-border-color: #e50914; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 15 20 30 20;">
                    <HBox alignment="CENTER" style="-fx-background-color: #e50914; -fx-background-radius: 4px; -fx-padding: 2 8 2 8;" maxWidth="50">
                        <Label text="HOT" style="-fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    </HBox>
                    <Label text="GÓI PHỔ BIẾN" style="-fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Label text="300 Xu" style="-fx-text-fill: #e50914; -fx-font-size: 26px; -fx-font-weight: bold;" />
                    <Label text="50.000 đ" style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" />
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="btnPack650" onAction="#handleSelectPack" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2"
                style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30 20 30 20;">
                    <Label text="GÓI THÀNH VIÊN" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Label text="650 Xu" style="-fx-text-fill: #e50914; -fx-font-size: 26px; -fx-font-weight: bold;" />
                    <Label text="100.000 đ" style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" />
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="btnPack1400" onAction="#handleSelectPack" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3"
                style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30 20 30 20;">
                    <Label text="GÓI VIP" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px; -fx-font-weight: bold;" />
                    <Label text="1400 Xu" style="-fx-text-fill: #e50914; -fx-font-size: 26px; -fx-font-weight: bold;" />
                    <Label text="200.000 đ" style="-fx-text-fill: #ffffff; -fx-font-size: 16px;" />
                </VBox>
            </graphic>
        </Button>
    </GridPane>

    <HBox style="-fx-background-color: #333333; -fx-min-height: 1px; -fx-pref-height: 1px;" />

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnCheckout" onAction="#handleCheckout" text="TIẾP TỤC THANH TOÁN" 
                style="-fx-background-color: #e50914; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 15 35 15 35; -fx-background-radius: 4px; -fx-cursor: hand;" />
    </HBox>
</VBox>