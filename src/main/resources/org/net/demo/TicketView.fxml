<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="section" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.net.demo.TicketsListController">
    <padding>
        <Insets bottom="40" left="60" right="60" top="40" />
    </padding>
    <children>
        
        <HBox alignment="CENTER_LEFT" spacing="15">
            <children>
                <Button onAction="#onBackClick" style="-fx-cursor: hand;" styleClass="btn-outline" text="← Quay lại" />
                <VBox spacing="2">
                    <children>
                        <Label styleClass="account-title" text="VÉ CỦA BẠN" />
                        <Label styleClass="hero-subtitle" text="Danh sách các vé phim bạn đã đặt thành công tại Cineverse." />
                    </children>
                </VBox>
            </children>
        </HBox>
   
        <ScrollPane fitToWidth="true" styleClass="scroll-pane-transparent" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="ticketsContainer" hgap="20" prefWrapLength="900" vgap="20" />
            </content>
        </ScrollPane>
    </children>
</VBox>